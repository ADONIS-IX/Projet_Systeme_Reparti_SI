pipeline {
    agent any

    environment {
        // ── Docker Hub ────────────────────────────────────────────────────
        DOCKER_HUB_USER   = 'adonisdocker'
        BACKEND_IMAGE     = "${DOCKER_HUB_USER}/backend"
        FRONTEND_IMAGE    = "${DOCKER_HUB_USER}/frontend"

        // ── Kubernetes ────────────────────────────────────────────────────
        KUBE_CONTEXT      = 'minikube'

        // ── URL de l'API (inject au build du frontend) ────────────────────
        // URL relative : Nginx proxifie /api/ → backend (fonctionne en Docker Compose et Kubernetes)
        REACT_APP_API_URL = "/api"
    }

    stages {

        // ── Étape 1 : Récupération du code ────────────────────────────────
        stage('Préparation') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
            }
        }

        // ── Étape 2 : Linting & Tests ─────────────────────────────────────
        stage('Linting & Tests') {
            parallel {

                stage('Backend — Lint & Tests') {
                    steps {
                        dir('backend') {
                            sh '''
                                python3 -m venv .venv
                                . .venv/bin/activate
                                pip install --quiet -r requirements.txt flake8
                                flake8 --max-line-length=120 \
                                       --exclude=.venv,migrations \
                                       .
                                USE_SQLITE=True python manage.py test --verbosity=2
                            '''
                        }
                    }
                }

                stage('Frontend — Lint & Tests') {
                    steps {
                        dir('frontend') {
                            sh '''
                                npm ci --silent
                                CI=true npm test -- --watchAll=false
                            '''
                        }
                    }
                }
            }
        }

        // ── Étape 3 : Build & Push des images Docker ──────────────────────
        stage('Build & Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        printf '%s' "$DOCKER_PASS" | sg docker -c "docker login -u '$DOCKER_USER' --password-stdin"
                    '''

                    // Backend
                    sh '''
                        sg docker -c "docker build -t '$BACKEND_IMAGE:$BUILD_NUMBER' ./backend"
                        if [ "$BRANCH_NAME" = "main" ]; then
                            sg docker -c "docker tag '$BACKEND_IMAGE:$BUILD_NUMBER' '$BACKEND_IMAGE:latest'"
                        fi
                        sg docker -c "docker push '$BACKEND_IMAGE:$BUILD_NUMBER'"
                        if [ "$BRANCH_NAME" = "main" ]; then
                            sg docker -c "docker push '$BACKEND_IMAGE:latest'"
                        fi
                    '''

                    // Frontend (injection de l'URL de l'API au moment du build)
                    sh '''
                        sg docker -c "docker build \
                            --build-arg REACT_APP_API_URL='$REACT_APP_API_URL' \
                            -t '$FRONTEND_IMAGE:$BUILD_NUMBER' ./frontend"
                        if [ "$BRANCH_NAME" = "main" ]; then
                            sg docker -c "docker tag '$FRONTEND_IMAGE:$BUILD_NUMBER' '$FRONTEND_IMAGE:latest'"
                        fi
                        sg docker -c "docker push '$FRONTEND_IMAGE:$BUILD_NUMBER'"
                        if [ "$BRANCH_NAME" = "main" ]; then
                            sg docker -c "docker push '$FRONTEND_IMAGE:latest'"
                        fi
                    '''
                }
            }
        }

        // ── Étape 4 : Déploiement Kubernetes ─────────────────────────────
        stage('Déploiement Kubernetes') {
            steps {
                script {
                    // Forcer le bon contexte Kubernetes et vérifier l'accès API
                    sh "kubectl config use-context ${KUBE_CONTEXT}"
                    sh 'kubectl cluster-info'

                    // Supprimer l'ancien Job de migration s'il existe
                    sh 'kubectl delete job django-migrate --ignore-not-found=true'
                    sh 'kubectl wait --for=delete job/django-migrate --timeout=60s || true'

                    // Rendre le manifest backend avec l'image du build courant (Job + Deployment backend)
                    sh """
                        sed 's|adonisdocker/backend:latest|${BACKEND_IMAGE}:${BUILD_NUMBER}|g' \
                            k8s/backend-deployment.yaml > k8s/backend-deployment.ci.yaml
                    """

                    // Appliquer les manifests dans l'ordre
                    sh 'kubectl apply -f k8s/secrets.yaml'
                    sh 'kubectl apply -f k8s/postgres-pvc.yaml'
                    sh 'kubectl apply -f k8s/postgres-deployment.yaml'
                    sh 'kubectl apply -f k8s/frontend-deployment.yaml'
                    sh 'kubectl apply -f k8s/backend-deployment.ci.yaml'

                    // Attendre la fin du Job de migration Django
                    sh 'kubectl wait --for=condition=complete job/django-migrate --timeout=120s'

                    // Mettre à jour les images avec le tag du build courant
                    sh """
                        kubectl set image deployment/backend  backend=${BACKEND_IMAGE}:${BUILD_NUMBER}
                        kubectl set image deployment/frontend frontend=${FRONTEND_IMAGE}:${BUILD_NUMBER}
                    """

                    // Attendre la fin du rollout
                    sh 'kubectl rollout status deployment/backend  --timeout=120s'
                    sh 'kubectl rollout status deployment/frontend --timeout=120s'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline terminé avec succès !'
        }
        failure {
            echo '❌ Échec du pipeline. Consultez les logs ci-dessus.'
        }
        always {
            sh 'sg docker -c "docker logout" || true'
            cleanWs()
        }
    }
}
